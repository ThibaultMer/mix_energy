MODEL_REGISTRY =
MLFLOW_TRACKING_URI = "http://localhost:5000"

# Airflow Docker runtime (compose file in airflow/)
# On Linux, set values with: id -u
AIRFLOW_IMAGE_NAME="mix-energy-airflow:local"
AIRFLOW_UID=#id -u
AIRFLOW_PROJ_DIR="."
AIRFLOW__API_AUTH__JWT_SECRET="airflow_jwt_secret"
AIRFLOW__API_AUTH__JWT_ISSUER="airflow"

# GCP region
LOCATION="europe-west1"
# GCP project ID
PROJECT_ID="mix-energie-gcp"
# GCP service account
GOOGLE_APPLICATION_CREDENTIALS=
# Artifact Registry name
REPOSITORY=
# Image name
IMAGE=
# Application port
PORT=
HOST_PORT=

# API base URL for Streamlit app
API_BASE_URL=
